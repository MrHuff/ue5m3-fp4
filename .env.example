# Local paths used by the public TorchTitan method-reproduction launcher.
# Use absolute paths and do not commit a populated .env file.
UE5M3_NEMOTRON_ASSETS=/absolute/path/to/nemotron-h-assets
UE5M3_DATA_ROOT=/absolute/path/to/prepared-olmo-mix
UE5M3_OUTPUT_ROOT=/absolute/path/to/results

# Safe single-process defaults. Override all rendezvous values consistently
# on every node for a multi-node run.
UE5M3_NNODES=1
UE5M3_NPROC_PER_NODE=1
UE5M3_NODE_RANK=0
UE5M3_MASTER_ADDR=127.0.0.1
UE5M3_MASTER_PORT=29500

# Optional development override. Leave unset to use the pinned submodule.
# UE5M3_TRAIN_ENTRYPOINT=/absolute/path/to/torchtitan/torchtitan/train.py

# One of: bf16, ue5m3-proposed-b16, ue5m3-proposed-b32,
# ue5m3-torch-control, ue5m3-te-settings, native-nvfp4-te, or
# native-nvfp4-no-rht-all.
UE5M3_OLMES_NUMERIC_PATH=bf16

# Public task reconstruction is the default and records a new request identity.
# Frozen replay is accepted only when both caller-supplied files match the
# reviewed paper hashes and complete inventories.
UE5M3_OLMES_REQUEST_MODE=public_task_rebuild
# UE5M3_OLMES_REQUEST_MANIFEST=/absolute/path/to/request-bundle-manifest.json
# UE5M3_OLMES_REQUEST_ARCHIVE=/absolute/path/to/request-bundle.tar.gz

# No credentials belong in this file. Hugging Face cache/authentication, when
# needed for public downloads, should use the standard client configuration
# outside the repository.
